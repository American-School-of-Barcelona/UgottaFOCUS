BLOCKLIST_APPS=[]
BLOCKLIST_WEBSITES=[]
focus_running=False
blocklist_file = os.path.join(os.path.dirname(__file__), 'blocklists.json')
violation_count = 0
session_duration_var = None

# Session tracking
session_blocked_apps = {}  # {app_name: count}
session_blocked_websites = {}  # {website: count}
session_start_time = None
session_duration_minutes = 0

def get_installed_apps():
    apps_dir="/Applications"
    apps=[]

    if not os.path.exists(apps_dir):
        return apps

    for item in os.listdir(apps_dir):
        if item.endswith(".app"):
            apps.append(item.replace(".app",""))

    return sorted(apps)

def load_blocklists():
    """Load saved blocklists from file"""
    global BLOCKLIST_APPS, BLOCKLIST_WEBSITES
    try:
        if os.path.exists(blocklist_file):
            with open(blocklist_file, 'r') as f:
                data = json.load(f)
                BLOCKLIST_APPS = data.get("apps", [])
                BLOCKLIST_WEBSITES = data.get("websites", [])
    except Exception as e:
        print(f"Error loading blocklists: {e}")

def save_blocklists():
    """Save blocklists to file"""
    try:
        data = {"apps": BLOCKLIST_APPS, "websites": BLOCKLIST_WEBSITES}
        with open(blocklist_file, 'w') as f:
            json.dump(data, f, indent=2)
    except Exception as e:
        print(f"Error saving blocklists: {e}")

def closeChromeTab(url, window_id):
    """Close a Chrome tab by URL using AppleScript"""
    global session_blocked_websites
    print(f"Attempting to close blocked website: {url}")
    
    # Track blocked website
    for site in BLOCKLIST_WEBSITES:
        if site.lower() in url.lower():
            session_blocked_websites[site] = session_blocked_websites.get(site, 0) + 1
            break
    
    # Close the tab using AppleScript
    try:
        script = f'''
        tell application "Google Chrome"
            set windowIndex to {window_id}
            repeat with w in windows
                repeat with t in tabs of w
                    if URL of t contains "{url.split('?')[0]}" then
                        close t
                        return true
                    end if
                end repeat
            end repeat
        end tell
        '''
        result = subprocess.run(['osascript', '-e', script], capture_output=True, text=True, timeout=3)
        print(f"AppleScript result: {result.returncode}")
    except Exception as e:
        print(f"Error closing Chrome tab: {e}")
    
    root.after(0, lambda: messagebox.showwarning("Hang on!", f"A blocked website was closed: {url}"))
    return True

def show_session_summary():
    """Show detailed summary after focus session ends"""
    global violation_count, session_blocked_apps, session_blocked_websites, session_start_time, session_duration_minutes
    try:
        # Calculate session details
        elapsed_time = session_duration_minutes
        hours = int(elapsed_time // 60)
        minutes = int(elapsed_time % 60)
        time_str = f"{hours}h {minutes}m" if hours > 0 else f"{minutes}m"
        
        # Build summary report
        summary = f"FOCUS SESSION COMPLETE!\n"
        summary += f"{'='*50}\n\n"
        summary += f"SESSION DURATION: {time_str}\n\n"
        
        summary += f"BLOCKLIST STATS:\n"
        summary += f"  • Apps in blocklist: {len(BLOCKLIST_APPS)}\n"
        summary += f"  • Websites in blocklist: {len(BLOCKLIST_WEBSITES)}\n\n"
        
        # Apps blocked breakdown
        if session_blocked_apps:
            summary += f"APPLICATIONS ATTEMPTED:\n"
            for app, count in sorted(session_blocked_apps.items(), key=lambda x: x[1], reverse=True):
                summary += f"  • {app}: {count}x blocked\n"
            summary += "\n"
        else:
            summary += f"No apps attempted to open\n\n"
        
        # Websites blocked breakdown
        if session_blocked_websites:
            summary += f"WEBSITES ATTEMPTED:\n"
            for site, count in sorted(session_blocked_websites.items(), key=lambda x: x[1], reverse=True):
                summary += f"  • {site}: {count}x blocked\n"
            summary += "\n"
        else:
            summary += f"No websites attempted to visit\n\n"
        
        summary += f"{'='*50}\n"
        summary += f"TOTAL VIOLATIONS: {violation_count}\n"
        
        if violation_count == 0:
            summary += f"Perfect focus session! No distractions!\n"
        
        # Show summary in a message box
        messagebox.showinfo("Focus Session Summary", summary)
        
        # Reset tracking
        violation_count = 0
        session_blocked_apps.clear()
        session_blocked_websites.clear()
        session_start_time = None
        session_duration_minutes = 0
        
    except Exception as e:
        print(f"Error showing summary: {e}")

